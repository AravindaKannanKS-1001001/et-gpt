# syntax=docker/dockerfile:1
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONUTF8=1 PYTHONIOENCODING=utf-8
# apt and pip caches survive rebuilds, so packages are not re-downloaded
# when only application source changes.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml ./
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -e . \
    && useradd --create-home --uid 10001 mcp \
    && mkdir -p /app/.qdrant_storage && chown mcp:mcp /app/.qdrant_storage
USER mcp
EXPOSE 8001 8002 8003
# Default command overridden by docker-compose (catalog/site/calc)
CMD ["python", "-m", "et_mcp.server", "--server", "all", "--transport", "streamable-http", "--port", "8001", "--host", "0.0.0.0"]
